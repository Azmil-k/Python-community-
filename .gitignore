__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel & build
.vercel
.turbo

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

